# Copie para backend/.env e preencha. O .env nunca deve ser versionado.

# --- Postgres (usado pelo compose.yaml) ---
POSTGRES_DB=cinematch
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=troque-me

# Conexão usada pelos scripts e pela API
DATABASE_URL=postgresql://cinematch:troque-me@localhost:5432/cinematch

# --- pgAdmin (usado pelo compose.yaml) ---
PGADMIN_EMAIL=voce@example.com
PGADMIN_PASSWORD=troque-me

# --- TMDB ---
# Use um dos dois (o Bearer token não aparece na URL)
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
JWT_SECRET=gere-com-python-c-import-secrets-print-secrets-token-urlsafe-32
